# Claude Code 5h使用量アラート 設定サンプル
# 使い方: このファイルを .env にコピーして値を埋める
#   cp .env.example .env
# .env は .gitignore 済み（コミットされない）。

# Discord の Webhook URL（必須）
# Discordの「サーバー設定 → 連携サービス → ウェブフック」で作成して貼る
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx"

# 5hウィンドウあたりの上限トークン数（必須・要キャリブレーション）
# 求め方:
#   1) Claude Code で /usage を実行し現在の5h使用率(%)を見る（例: 30）
#   2) npx -y ccusage@latest blocks --active --json | jq '.blocks[0].totalTokens'
#   3) TOKEN_BUDGET = totalTokens ÷ (％/100)
#      例: totalTokens=9837974, /usage=30% なら 9837974 / 0.30 ≒ 32793246
TOKEN_BUDGET="32793246"

# 通知する閾値（スペース区切り・%）。各5hブロックで1回ずつ通知。
THRESHOLDS="50 80"
